# Public base URL of the site (e.g. https://docipl.vercel.app; http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=
# Supabase project URL (server-side only; never used in the browser)
SUPABASE_URL=
# Supabase service role key (server-side only; keep secret)
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile site key. Test key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key. Test key: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Secret used to hash voter identifiers (min 32 chars)
HASH_SECRET=
# Password for the admin area (min 8 chars)
ADMIN_PASSWORD=
# Secret used to sign admin session cookies (min 32 chars)
ADMIN_SESSION_SECRET=
# Rate limit for token minting, format max/windowSeconds (default 60/600)
RATE_LIMIT_MINT=
# Rate limit for voting, format max/windowSeconds (default 30/600)
RATE_LIMIT_VOTE=
# Rate limit for status checks, format max/windowSeconds (default 120/60)
RATE_LIMIT_STATUS=
# Rate limit for admin login attempts, format max/windowSeconds (default 10/900)
RATE_LIMIT_ADMIN_LOGIN=
